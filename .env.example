# Copy to .env and fill in.

# OpenAI — reasoning engine, salience judging, abstraction, embeddings
OPENAI_API_KEY=sk-...
BUBBLES_LLM_MODEL=gpt-4o-mini
BUBBLES_EMBED_MODEL=text-embedding-3-small

# Postgres + pgvector
BUBBLES_PG_DSN=postgresql://localhost:5432/bubbles

# Set to 1 to run the cognitive loop with deterministic stubs instead of the
# OpenAI API (no key required). Useful for testing the architecture itself.
BUBBLES_MOCK=0
