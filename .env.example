# Copy to .env and fill in.

# Provider / credentials
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=                 # custom/compatible endpoint; blank = standard OpenAI

# The ONE base LLM. Used identically by BOTH the vanilla RAG baseline and the
# Taco layer. Taco is a memory layer over this model — it never swaps the model,
# only the context assembled around it.
BASE_LLM_MODEL=gpt-4o-mini
BASE_EMBED_MODEL=text-embedding-3-small

# Embeddings can use a SEPARATE provider from chat (e.g. chat on Azure,
# embeddings on OpenAI). Leave blank to reuse the chat key/endpoint above.
EMBED_API_KEY=                   # e.g. an OpenAI sk-... key for embeddings
EMBED_BASE_URL=                  # blank = standard api.openai.com

# Postgres + pgvector
TACO_PG_DSN=postgresql://localhost:5432/taco

# Set to 1 to run the cognitive loop with deterministic stubs instead of the
# OpenAI API (no key required). Useful for testing the architecture itself.
TACO_MOCK=0
